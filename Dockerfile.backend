# ── StockRadar IN — Backend Container ─────────────────────────────────────────
# Runs FastAPI + APScheduler on port 8000
# Build context: project root (so it can access Analyzer.py + core/)
# ──────────────────────────────────────────────────────────────────────────────

FROM python:3.11-slim

# System deps (for lxml, numpy native extensions)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ libffi-dev libssl-dev curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies first (cached layer)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy entire project (Analyzer.py + core/ + backend/)
COPY . .

# Persistent data directory (mount a NAS volume here)
RUN mkdir -p /app/backend/data

# Health check — hits /api/health (public; /api/status now requires auth)
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

EXPOSE 8000

# Launch from backend/, exactly as the local run and CLAUDE.md describe.
# This is load-bearing: api.py imports its siblings bare (`from auth import ...`,
# `from security import ...`), which only resolves when backend/ is on sys.path.
# Running `uvicorn backend.api:app` from /app instead crashes at import with
# "No module named 'auth'". api.py puts the project root on sys.path itself, so
# core/ and Analyzer.py still resolve from here.
WORKDIR /app/backend

CMD ["python", "-m", "uvicorn", "api:app", \
     "--host", "0.0.0.0", "--port", "8000", \
     "--workers", "1", "--no-access-log"]
