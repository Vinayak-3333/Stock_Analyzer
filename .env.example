# StockRadar IN — configuration template
# ======================================
# Copy to `.env` in the project root and fill in. `.env` is gitignored; this
# file is the committed, placeholder-only reference. NOTHING real goes in here.
#
#   cp .env.example .env
#
# `.env` is the single source of config — there is no backfill from any other
# file. Anything omitted falls back to the default shown in brackets.

# ── Email alerts (required) ───────────────────────────────────────────────────
GMAIL_SENDER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx    # 16-char Gmail App Password, not your login password
RECIPIENT_EMAIL=you@gmail.com

# ── Google OIDC (required — without these the API is unreachable) ─────────────
# Create an OAuth 2.0 Web client at console.cloud.google.com → Credentials.
# OIDC_REDIRECT_URI must match an "Authorized redirect URI" there EXACTLY,
# including scheme, host, port and path. Register one per environment.
OIDC_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback

# Where the backend sends the browser after login/logout — your SPA's origin.
FRONTEND_URL=http://localhost:5173

# Comma-separated allow-list of verified Google emails. [defaults to RECIPIENT_EMAIL]
# Anyone not listed is rejected after authenticating, and logged as login.rejected.
ALLOWED_EMAILS=

# ── Session (required) ────────────────────────────────────────────────────────
# Signs the session cookie. Must be set and STABLE — if it changes, every
# existing session is silently invalidated. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_MAX_AGE=28800                     # seconds [28800 = 8h]

# Cookie flags depend entirely on topology:
#   same-site (SPA and API share a site, incl. localhost:5173 -> :8000, since
#              SameSite ignores port)          -> lax  / secure as appropriate
#   cross-site (e.g. a Vercel SPA -> separate backend domain)
#                                              -> none / secure MUST be true
# SameSite=none without Secure is rejected by every modern browser.
SESSION_COOKIE_SAMESITE=lax               # lax | none [lax]
SESSION_COOKIE_SECURE=false               # true wherever you serve over HTTPS [false]

# Comma-separated browser origins allowed to call the API with credentials.
# [defaults to FRONTEND_URL]. A "*" origin is illegal with credentials.
CORS_ALLOW_ORIGINS=

# ── Hardening (Phase 4) ───────────────────────────────────────────────────────
SECURITY_HSTS_ENABLED=false               # true only where TLS terminates [false]
# Honour X-Forwarded-For. ONLY enable behind a trusted reverse proxy — exposed
# directly it lets anyone forge their way past the per-IP rate limit. Behind a
# proxy with this off, every unauthenticated client shares one bucket.
TRUST_PROXY_HEADERS=false
DOCS_ENABLED=true                         # serve /docs + /openapi.json to a logged-in user [true]
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TRIGGER=5                      # /api/trigger per hour [5]
RATE_LIMIT_AUTH=20                        # /auth/* per minute [20]
RATE_LIMIT_API=240                        # /api/* per minute [240]

# ── Pipeline tuning (all optional) ────────────────────────────────────────────
DEEP_ANALYSIS_COUNT=400                   # Tier-2 shortlist size [400]
FUNDAMENTALS_CACHE_TTL_DAYS=7             # DuckDB fundamentals cache TTL [7]
TIER2_WORKERS=32                          # Tier-2 thread pool [32]
TIER2_DEADLINE_MINUTES=20                 # hard Tier-2 budget; run continues with partials [20]
BULK_PARALLEL_CHUNKS=2                    # parallel bulk yf.download chunks [2]
ANALYSIS_STALE_MINUTES=90                 # wedged-run guard [90]
SCHEDULER_ENABLED=true                    # 09:15/15:30 IST runs; false = manual runs only [true]
# INTERNAL_TRIGGER_TOKEN=                 # enables POST /internal/run for a k8s CronJob; unset = route is 404 [unset]

# No market-data API keys are needed. NSE and Yahoo require no credentials; the
# keyed-provider chain was removed once confirmed dead.

# ── Tailscale Funnel deployment (docker-compose.funnel.yml) ───────────────────
# Funnel terminates TLS itself, so there is no ACME_EMAIL and no DNS record.
# APP_DOMAIN is your Funnel hostname — find it with `tailscale status`.
# APP_DOMAIN=your-machine.tailXXXX.ts.net
# FUNNEL_PORT=8088                        # loopback port Funnel proxies to.
#                                         # Avoid 8080: Oracle XE's TNS listener
#                                         # (TNSLSNR) binds it by default.
# TRUST_PROXY_HEADERS=false               # see docs/DEPLOYMENT.md before enabling

# ── Cloud deployment (docker-compose.cloud.yml) ───────────────────────────────
# Only needed on the server. The compose file derives OIDC_REDIRECT_URI,
# FRONTEND_URL and CORS_ALLOW_ORIGINS from APP_DOMAIN, and hard-codes the
# cookie/hardening flags that HTTPS requires — so do NOT also set those here.
#
# APP_DOMAIN must be a real hostname with a valid public TLD. Google rejects
# raw IPs and non-HTTPS redirect URIs, so the instance's public IP will not do.
# A free DuckDNS subdomain works — no domain purchase needed. See
# docs/DEPLOYMENT.md step 3. Reserve the Oracle public IP first (free), or the
# address changes on stop/start and silently breaks DNS and the redirect URI.
APP_DOMAIN=yourname.duckdns.org
ACME_EMAIL=you@gmail.com                  # Let's Encrypt expiry notices
TIER2_WORKERS=8                           # free-tier vCPUs are weak; 32 is a laptop default
DOCS_ENABLED=false
